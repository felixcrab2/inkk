# Copy this file to `.env.local` (which is gitignored) and fill in the values.
# `npm run build` reads it and generates lib/config.cjs (for the main process)
# and inlines the same values into renderer/bundle.js.
#
# Supabase values come from Supabase → Settings → API / Data API. Use the
# PUBLISHABLE (anon) key only — never the secret key; this is a client app.
# They are only needed for the certify step (sign-in); recording works without.

REACT_APP_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
REACT_APP_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Where /api/certify lives. Default is fine unless you're testing locally.
INKK_API_BASE=https://inkk.site
