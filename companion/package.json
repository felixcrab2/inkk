{
  "name": "inkk-companion",
  "version": "0.1.0",
  "private": true,
  "description": "inkk desktop companion \u2014 records writing rhythm system-wide and issues a verification code.",
  "main": "main.js",
  "scripts": {
    "build": "node build.js",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --inspect",
    "test": "node --test capture.test.js lib/sessions.test.js lib/codes.test.js",
    "dist": "npm run build && electron-builder --mac dmg",
    "release": "./scripts/release.sh",
    "install-cert": "./scripts/install-cert.sh"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "node-mac-permissions": "^2.5.0",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.23.0"
  },
  "build": {
    "appId": "site.inkk.companion",
    "productName": "inkk",
    "files": [
      "main.js",
      "preload.js",
      "capture.js",
      "lib/**/*.js",
      "lib/*.cjs",
      "!lib/*.test.js",
      "renderer/index.html",
      "renderer/styles.css",
      "renderer/bundle.js",
      "renderer/mock.js",
      "renderer/fonts/**",
      "assets/**"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**",
      "node_modules/node-mac-permissions/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "inkk reads the text of the document in front only to fingerprint it when you certify, and to notice inkk codes in what you're reading. The text never leaves your Mac."
      },
      "notarize": false
    },
    "dmg": {
      "title": "inkk"
    }
  }
}
