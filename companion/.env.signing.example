# Apple credentials for signing + notarizing the DMG.
# Copy to `.env.signing` (gitignored) and fill in. Never commit the real file.

# developer.apple.com/account → Membership details → Team ID (10 chars)
APPLE_TEAM_ID=XXXXXXXXXX

# The Apple ID you enrolled with
APPLE_ID=you@example.com

# account.apple.com → Sign-In and Security → App-Specific Passwords
# (format: abcd-efgh-ijkl-mnop) — NOT your real Apple ID password
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx
