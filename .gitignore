node_modules/
.env
.env.local
.env*.local
.DS_Store
scripts/_pdf-out/

# production build output — Vercel rebuilds from source, so it's not committed
# (committing it caused content-hash merge conflicts on every change)
/build

# seed: local credentials + the run ledger (records created users/passwords)
scripts/seed/.env
scripts/seed/.seed-ledger.json
# regenerable Gutenberg pipeline output (active content is posts.json)
scripts/seed/content.json

# local font comparison screenshots (not for commit)
font-previews/

# Capacitor iOS: the project is committed, its build output is not
/ios/App/App/public
/ios/App/build
/ios/App/Pods
/ios/DerivedData
/ios/App/App/capacitor.config.json

# The companion app's source is tracked; its build output, node_modules and env
# files are handled by companion/.gitignore, which git can only read if this
# directory is not ignored wholesale.

# Carousel source images and rendered output, both large and regenerable
scripts/assets/
tiktok-carousels/
